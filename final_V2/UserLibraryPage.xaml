<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="final_V2.UserLibraryPage"
             BackgroundColor="#14181c">

    <Grid RowDefinitions="Auto, *" BackgroundColor="#14181c">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20">
            <Label x:Name="TitleLabel" 
                   Grid.Column="0"
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalOptions="Center"/>
            
            <Button x:Name="FollowButton"
                    Grid.Column="1"
                    Text="Takip Et"
                    Clicked="OnFollowClicked"
                    BackgroundColor="#00c02c"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="40"
                    IsVisible="False"/>
        </Grid>

        <CollectionView Grid.Row="1" 
                        x:Name="MovieCollection"
                        SelectionMode="Single"
                        SelectionChanged="OnMovieSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" 
                                  HorizontalItemSpacing="10" VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="5">
                        <Border Stroke="Gray" 
                                StrokeThickness="0.5" 
                                BackgroundColor="#2c3440" 
                                HeightRequest="150"
                                StrokeShape="RoundRectangle 8">
                            <Grid>
                                <Label Text="🎬" 
                                       FontSize="40"
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       TextColor="Gray"
                                       Opacity="0.5"/>
                                
                                <Image Source="{Binding ThumbnailUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="150"/>

                                <Label Text="{Binding Rating}" 
                                       VerticalOptions="End" 
                                       HorizontalOptions="End" 
                                       Margin="5"
                                       TextColor="#00c02c"
                                       FontAttributes="Bold"
                                       BackgroundColor="#80000000"
                                       Padding="3"/>
                            </Grid>
                        </Border>
                        <Label Text="{Binding Name}" 
                               TextColor="White" 
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
