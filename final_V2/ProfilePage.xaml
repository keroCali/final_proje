<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="final_V2.ProfilePage"
             Title="Profilim"
             BackgroundColor="#14181c">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <!-- Profil Üst Bölüm -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Border BackgroundColor="#2c3440" HeightRequest="120" WidthRequest="120" StrokeShape="RoundRectangle 60" StrokeThickness="0">
                    <Label Text="👤" FontSize="60" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
                <Label x:Name="UsernameLabel" TextColor="White" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label x:Name="JoinDateLabel" TextColor="#888888" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Bio Bölümü -->
            <Frame BackgroundColor="#1e232b" BorderColor="#333333" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="Düzenle" Clicked="OnEditBioClicked" BackgroundColor="Transparent" TextColor="#00c02c" FontSize="12" HeightRequest="30" Padding="0"/>
                    </HorizontalStackLayout>
                    <Label x:Name="BioLabel" TextColor="#bbbbbb" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Sosyal İstatistikler -->
            <Grid ColumnDefinitions="*, *, *" Padding="10">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label x:Name="ReelCountLabel" Text="0" TextColor="#ffffff" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Reels" TextColor="#888888" FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label x:Name="FollowersLabel" Text="0" TextColor="#ffffff" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Takipçi" TextColor="#888888" FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label x:Name="FollowingLabel" Text="0" TextColor="#ffffff" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Takip" TextColor="#888888" FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Özet Bilgiler -->
            <Frame BackgroundColor="#1e232b" BorderColor="#333333" Padding="15" HasShadow="False">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="40">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label x:Name="AvgRatingLabel" Text="0.0" TextColor="#00c02c" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Ortalama Puan" TextColor="#888888" FontSize="12" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Favori Reel (Highlights) -->
            <VerticalStackLayout Spacing="10" x:Name="TopReelSection" IsVisible="False">
                <Label Text="⭐ En Yüksek Puanlı Paylaşımım" TextColor="#888888" FontSize="14" FontAttributes="Bold" Margin="5,0"/>
                <Frame BackgroundColor="#2c3440" BorderColor="#00c02c" Padding="15" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="🎬" FontSize="30" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label x:Name="TopReelNameLabel" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="TopReelRatingLabel" TextColor="#00c02c" FontSize="14" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <Button Text="Çıkış Yap" 
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#E50914"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,10,0,40"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
